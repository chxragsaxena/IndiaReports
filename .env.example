# Copy to .env and adjust. `.env` is git-ignored. Docker Compose reads it automatically.

# ---- Host ports (change if something else on your machine already uses them) ------------
REPORT_PORT=8000
NOTIFIER_PORT=8100
ANALYTICS_PORT=8200
POSTGRES_PORT=5432
REDIS_PORT=6379
STORAGE_PORT=9000
OLLAMA_PORT=11434

# ---- Photo storage (S3-compatible). Local defaults work as they are. -------------------
# S3_ACCESS_KEY=devaccesskey
# S3_SECRET_KEY=devsecretkey123

# ---- AI photo analysis: an open-weight VISION model --------------------------------------
# The model must be able to read images. Text-only models (llama3, and gpt-oss that PullWise
# uses) cannot: use a vision model (a Llama 4, Qwen3-VL, Gemma 3 or LLaVA).
#
# Option A (like PullWise): Groq hosts open-weight models. Free key: console.groq.com/keys
# The same GROQ_API_KEY works for both projects. NOTE: photos are sent to Groq.
# Defaults to qwen/qwen3.8-27b, an open-weight Qwen that sees images (override with ANALYSIS_MODEL).
#   GROQ_API_KEY=
#
# Or run the model yourself (photos stay on your infrastructure). Setting ANALYSIS_BASE_URL
# takes priority over Groq.
# Option 1: Ollama installed on this machine (the service reaches it through the host):
#   ANALYSIS_BASE_URL=http://host.docker.internal:11434/v1
# Option 2: the bundled container (docker compose --profile ai up -d ollama):
#   ANALYSIS_BASE_URL=http://ollama:11434/v1
# Option 3: a GPU server running vLLM:
#   ANALYSIS_BASE_URL=http://your-gpu-host:8000/v1
#
# ANALYSIS_BASE_URL=
# ANALYSIS_MODEL=qwen3-vl:4b
#
# No model yet? Show the whole flow with clearly labelled demo findings (never alerts anyone):
# ANALYSIS_PROVIDER=mock

# ---- Alerts -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=

# ---- Email (resolved notices to citizens, assignment alerts to officers) ----------------
# EMAIL_PROVIDER=log          # local default: print emails in the service log
# RESEND_API_KEY=             # production: https://resend.com (works where SMTP is blocked)
# EMAIL_FROM=IndiaReports <onboarding@resend.dev>
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=
# PUBLIC_APP_URL=https://your-site.vercel.app   # links inside emails
# How long officers have to resolve a report, and how long a resolved one stays on the map:
# ESCALATION_AFTER_SECONDS=604800
# RESOLVED_VISIBLE_SECONDS=259200

# ---- Production secrets (set long random values; never commit them) ---------------------
# JWT_SECRET=
# REQUIRE_LOGIN_TO_REPORT=true
