{
  "name": "IndiaReports",
  "short_name": "IndiaReports",
  "description": "Report civic issues on the map of India, watch them appear live, and see which ones get fixed.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
